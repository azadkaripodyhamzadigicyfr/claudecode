# Odoo 19 Environment Configuration
# Copy this file to .env and update the values as needed

# Database Configuration
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
DB_HOST=db
DB_PORT=5432

# Odoo Configuration
ODOO_PORT=8069
ODOO_CHAT_PORT=8072

# pgAdmin Configuration (Optional - only used with --profile dev)
PGADMIN_EMAIL=admin@odoo.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Security Settings
# IMPORTANT: Change these in production!
# Generate a strong admin password with: python3 -c "from passlib.context import CryptContext; print(CryptContext(['pbkdf2_sha512']).hash('your_password'))"
ODOO_ADMIN_PASSWORD=admin

# Email Configuration (Optional)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SSL=False
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=your-email@gmail.com

# Development Settings
# Set to 'True' for development mode
DEV_MODE=True

# Worker Configuration (for production)
# Uncomment and adjust based on your server resources
# WORKERS=5
# MAX_CRON_THREADS=2

# Memory Limits (for production)
# LIMIT_MEMORY_HARD=2684354560
# LIMIT_MEMORY_SOFT=2147483648
